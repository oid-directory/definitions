objectclasses: ( 1.3.6.1.4.1.56521.101.2.5.10
          NAME 'jointISOITUTRegistration'
          DESC 'X.660, cl. A.2: Joint ISO/ITU-T Administration'
          SUP ( x660Context $
                x680Context $
                x690Context )
          AUXILIARY
          MAY longArc )
