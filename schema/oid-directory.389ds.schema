objectclasses: ( 1.3.6.1.4.1.56521.101.2.5.11
          NAME 'spatialContext'
          DESC 'Logical spatial orientation and association class'
          SUP registration AUXILIARY
          MAY ( topArc $
                supArc $
                subArc $
                minArc $
                maxArc $
                leftArc $
                rightArc ) )
