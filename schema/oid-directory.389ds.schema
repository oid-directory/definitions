          NAME 'currentAuthorityContext'
          DESC 'Current registration authority class'
          SUP top AUXILIARY
          MAY ( currentAuthorityCommonName $
                currentAuthorityCountryCode $
                currentAuthorityCountryName $
                currentAuthorityEmail $
