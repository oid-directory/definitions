#
objectclasses: ( 1.3.6.1.4.1.56521.101.2.5.12
          NAME 'registrationSupplement'
          DESC 'Supplemental registration class'
          SUP registration AUXILIARY
          MAY ( discloseTo $ isFrozen $ isLeafNode $
